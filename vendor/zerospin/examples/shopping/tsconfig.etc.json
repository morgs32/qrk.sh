{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@zerospin/backup-worker": [
        "../../packages/backup-worker/dist/index.d.ts"
      ],
      "virtual:pwa-register/react": [
        "./node_modules/vite-plugin-pwa/react.d.ts"
      ]
    },
    "types": ["vite/client", "node", "./src/cloudflare-workers.d.ts"]
  },
  "include": [
    "zerospin.config.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "*.jsonc",
    "*.d.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "references": [
    {
      "path": "../../packages/react"
    },
    {
      "path": "../../packages/sdk"
    },
    {
      "path": "../../packages/error"
    },
    {
      "path": "../../packages/cli"
    }
  ]
}
