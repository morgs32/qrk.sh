{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@qrk.sh/api",
  "targets": {
    "build": {
      "dependsOn": ["^lib", { "projects": ["@qrk.sh/library"], "target": "build" }],
      "outputs": ["{projectRoot}/dist"]
    },
    "tsc": {
      "dependsOn": ["^lib", { "projects": ["@qrk.sh/library"], "target": "build" }]
    },
    "test:workerd": {
      "dependsOn": ["^lib", { "projects": ["@qrk.sh/library"], "target": "build" }]
    },
    "dev": {
      "continuous": true,
      "dependsOn": ["^lib", { "projects": ["@qrk.sh/library"], "target": "build" }]
    }
  }
}
