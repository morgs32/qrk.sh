{
  "name": "@zerospin/fixtures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "config:lib": "tsc -b tsconfig.config.json",
    "ts:node": "tsc -p tsconfig.node.json --noEmit",
    "ts:workerd": "tsc -p tsconfig.workerd.json --noEmit",
    "ts:sync": "tsc -p tsconfig.sync.json --noEmit",
    "lint": "oxlint src --format stylish",
    "ts:cli": "tsc -p tsconfig.cli.json --noEmit"
  },
  "dependencies": {
    "@zerospin/browser": "workspace:*",
    "@zerospin/core": "workspace:*",
    "@zerospin/dev-worker": "workspace:*",
    "@zerospin/devtools": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/fulfillment": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/purchase": "workspace:*",
    "@zerospin/schema": "workspace:*",
    "@zerospin/sync": "workspace:*",
    "system-worker": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@remix-run/route-pattern": "^0.22.1",
    "@types/node": "^25.9.4",
    "agents": "^0.17.0",
    "capnweb": "^0.12.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-rc.111",
    "partyserver": "^0.5.8",
    "rimraf": "^6.1.3",
    "tiny-invariant": "^1.3.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
