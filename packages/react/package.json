{
  "name": "@zerospin/react",
  "version": "2.0.1",
  "private": false,
  "description": "Zerospin internal APIs (merged library)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json && node -e \"const fs=require('node:fs'); const syncWasm=require.resolve('@livestore/wa-sqlite/dist/wa-sqlite.wasm'); fs.copyFileSync(syncWasm, 'dist/wa-sqlite.wasm');\"",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/core": "workspace:*",
    "@zerospin/devtools": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/frontend": "workspace:*",
    "@zerospin/live-query": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/shared-worker": "workspace:*",
    "capnweb": "^0.7.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.17-67b1795",
    "effect": "^3.21.4",
    "swr": "^2.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/opentelemetry": "^0.63.0",
    "@effect/vitest": "^0.29.0",
    "@livestore/wa-sqlite": "^1.0.5",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.12.2",
    "next": "^16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "^0.48.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "effect": "^3.17.11",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
