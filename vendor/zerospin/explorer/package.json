{
  "name": "explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts --format stylish --deny-warnings",
    "test": "vitest run",
    "format:check": "oxfmt --check src scripts vite.config.ts tsconfig.json index.html README.md"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.21.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.9"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test": {
        "cache": true
      },
      "typecheck": {
        "cache": true
      },
      "lint": {
        "cache": true
      },
      "format:check": {
        "cache": true
      }
    }
  }
}
