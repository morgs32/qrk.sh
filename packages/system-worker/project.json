{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "system-worker",
  "targets": {
    "lib": {
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/core",
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/shapes"
          ]
        }
      ]
    },
    "dev": {
      "continuous": true
    },
    "static-cutover:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/checkStaticCutover.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "contract-programs:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx src/fixtures/contractPrograms.ts",
        "cwd": "packages/system-worker"
      }
    },
    "async-contracts:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx src/fixtures/asyncContracts.ts",
        "cwd": "packages/system-worker"
      }
    },
    "async-contracts:runtime-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "node scripts/checkAsyncContractsRuntime.mjs",
        "cwd": "packages/system-worker"
      }
    },
    "command-history:restart:check": {
      "dependsOn": ["^lib"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/checkDurableCommandHistory.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "actor-staging:check": {
      "dependsOn": ["^lib"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/checkActorStaging.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "repo-lifecycle:check": {
      "dependsOn": ["^lib"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/checkRepoLifecycle.mjs",
        "cwd": "{projectRoot}"
      }
    }
  }
}
