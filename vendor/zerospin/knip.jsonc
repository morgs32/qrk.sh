{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Default mode includes tests as importers, so exports only referenced from specs look "used".
  // Run `pnpm knip:production` to analyze shippable code only (--production --include-entry-exports).
  "include": ["files", "exports", "types"],
  "ignore": [
    "vendor/**",
    "llm-wiki/**",
    "**/*.config.{js,cjs,mjs,ts,tsx}",
    "**/vitest*.{js,cjs,mjs,ts,tsx}",
    "**/*GlobalSetup.{js,cjs,mjs,ts,tsx}",
    "**/vitest-env.d.ts",
    "**/*.typecheck.ts",
    ".agents/skills/**",
    ".github/skills/**",
  ],
  // *RepoTables.ts: shapes/tables used only inside the same module
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "**/components/ui/**": ["exports"],
    "examples/shopping/src/components/ui/**": ["exports"],
    "packages/sync/e2e/FixtureStateRepo.ts": ["exports"],
    "packages/sync/e2e/FixtureSyncAgent.ts": ["exports"],
    "packages/sync/e2e/worker.ts": ["exports"],
    "packages/system-worker/src/types.ts": ["types"],
  },
  "workspaces": {
    ".": {
      "entry": ["nx.json", ".github/workflows/*.yml"],
      "ignoreDependencies": [
        "@changesets/cli",
        "@zerospin/cli",
        "madge",
        "react",
        "react-dom",
        "rimraf",
        "tsafe",
        "tslib",
      ],
    },
    "examples/shopping": {
      "entry": [
        "src/zerospin/session.worker.ts",
        "zerospin.config.ts",
        "vitest.config.ts",
        // Referenced as string paths from zerospin.config.ts
        "src/zerospin/system.ts",
        "src/zerospin/seeds.ts",
        "src/zerospin/models.ts",
        "src/zerospin/frontend.ts",
      ],
      "ignoreFiles": ["vitest-env.d.ts"],
      "vitest": true,
      "next": true,
    },
    "examples/parking": {
      "entry": [
        "src/zerospin/provider.session.worker.ts",
        "src/zerospin/owner.session.worker.ts",
        "zerospin.config.ts",
        "vitest.config.ts",
        "src/zerospin/system.ts",
        "src/zerospin/seeds.ts",
        "src/zerospin/models.ts",
        "src/zerospin/frontends.ts",
      ],
      "ignoreFiles": ["vitest-env.d.ts"],
      "vitest": true,
      "next": true,
      "playwright": true,
    },
    "e2e/frontend-adapters": {
      "entry": ["tests/frontendAdapters.workerd.spec.ts"],
      "vitest": true,
    },
    "packages/core": {
      "entry": [
        "src/**!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.ts!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.tsx!",
      ],
      "project": [
        "src/**!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.ts!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.tsx!",
      ],
      "vitest": true,
    },
    "packages/cli": {
      "entry": ["src/cli.tsx", "src/commands/**/*.tsx", "src/commands/**/*.ts"],
      "vitest": true,
    },
    "packages/dev-worker": {
      "entry": [
        "src/DevWorker.ts",
        "src/emptySeeds.ts",
        // Selected through ignored Workerd Vitest and Wrangler config string paths.
        "tests/workerd/DevWorker.restart.fixture.worker.ts",
        "tests/workerd/DevWorker.system-repo.workerd.spec.ts",
        // Loaded as the custom seeds module through a node:path config value.
        "tests/workerd/devSeeds.fixture.ts",
      ],
      "vitest": true,
    },
    "packages/production-worker": {
      "entry": [
        // Resolved with node:path beside the exported ProductionWorker entrypoint.
        "src/emptySeeds.ts",
        // Selected through ignored Vitest and Wrangler config string paths.
        "tests/workerd/ProductionWorker.system-repo.workerd.spec.ts",
        // Loaded as the custom seeds module through a node:path config value.
        "tests/workerd/productionSeeds.fixture.ts",
      ],
      "vitest": true,
    },
    "packages/devtools": {
      "entry": [
        "src/ZerospinDevtools.tsx",
        "src/types.ts",
        "src/zerospinDevtoolsStore.ts",
      ],
      "vitest": true,
    },
    "packages/live-query": {
      "entry": ["src/makeLiveQuery.ts"],
      "vitest": true,
    },
    "packages/logger": {
      "entry": [
        // Wrangler main whose named exports register the workerd fixture classes.
        "specs/workerd/finalizeAccountCommands/SystemApi.ts",
      ],
      "vitest": true,
    },
    "packages/error": {
      "entry": ["src/index.ts"],
      "vitest": true,
    },
    "packages/react": {
      "entry": ["src/index.ts", "vitest.setup.ts!"],
      "vitest": true,
    },
    "packages/sdk": {
      "entry": ["src/index.ts"],
      "vitest": true,
    },
    "packages/system": {
      "entry": ["src/index.ts"],
      "vitest": true,
    },
    "packages/sync": {
      "entry": [
        // Selected by ignored custom Vitest config include globs.
        "e2e/Sync.useAgent.platform.playwright.spec.tsx",
        "e2e/Sync.useAgent.playwright.spec.tsx",
        "e2e/Sync.workerd.spec.ts",
        // Referenced as the ignored Wrangler dispatch config's main string path.
        "e2e/dispatchWorker.ts",
      ],
      "vitest": true,
    },
    "packages/system-worker": {
      "entry": [
        "src/TestWorker.ts",
        "vitest.workerd.config.ts",
        "vitest.node.config.ts",
      ],
      "paths": {
        "system": ["./src/fixtures/system.ts"],
      },
      "ignore": ["worker.d.ts"],
      "ignoreFiles": ["vitest.workerd.config.ts"],
      "vitest": true,
      "wrangler": {
        "config": ["wrangler.jsonc", "wrangler.vitest.jsonc"],
      },
    },
  },
}
