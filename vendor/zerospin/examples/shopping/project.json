{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shopping",
  "targets": {
    "test:workerd": {
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/browser",
            "@zerospin/dev-worker",
            "@zerospin/sdk"
          ]
        }
      ]
    },
    "agents:cold-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx --tsconfig tsconfig.json src/zerospin/fixtures/coldAgents.ts",
        "cwd": "examples/shopping"
      }
    },
    "build": {
      "dependsOn": ["^lib"]
    },
    "tsc:typecheck": {
      "executor": "nx:run-script",
      "options": {
        "script": "ts"
      },
      "dependsOn": ["^lib"]
    },
    "preview": {
      "continuous": true,
      "dependsOn": ["build"]
    },
    "dev": {
      "continuous": true,
      "dependsOn": ["^lib", "zerospin:dev"]
    },
    "zerospin:dev": {
      "continuous": true,
      "dependsOn": ["^lib"]
    },
    "deploy:app": {
      "executor": "nx:run-script",
      "options": {
        "script": "deploy:app"
      },
      "dependsOn": ["build"]
    },
    "deploy:zerospin": {
      "executor": "nx:run-script",
      "options": {
        "script": "deploy:zerospin"
      },
      "dependsOn": ["^lib"]
    },
    "agent-preview:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx --tsconfig tsconfig.json src/zerospin/fixtures/fulfillment.ts",
        "cwd": "examples/shopping"
      }
    },
    "marketplace:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx --tsconfig tsconfig.json src/zerospin/fixtures/marketplace.ts",
        "cwd": "examples/shopping"
      }
    },
    "checkout:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx --tsconfig tsconfig.json src/zerospin/fixtures/checkoutEndpoint.ts",
        "cwd": "examples/shopping"
      }
    },
    "local-backend:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx --tsconfig tsconfig.json src/zerospin/fixtures/localBackend.ts",
        "cwd": "examples/shopping"
      }
    }
  }
}
