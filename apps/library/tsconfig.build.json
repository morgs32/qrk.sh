{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "node", "react/canary"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "app/**",
    "worker/**",
    "vite*.ts",
    "next.config.ts",
    "next-env.d.ts",
    ".next",
    "dist",
    "build",
    "node_modules",
    "test-results",
    "cloudflare-test.d.ts",
    "vitest.worker.config.ts"
  ]
}
