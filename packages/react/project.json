{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/react",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/tsconfig.tsbuildinfo"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/browser",
            "@zerospin/core",
            "@zerospin/devtools",
            "@zerospin/error",
            "@zerospin/live-query",
            "@zerospin/logger",
            "@zerospin/shapes",
            "@zerospin/sdk"
          ]
        }
      ]
    },
    "watch": {
      "continuous": true
    },
    "test": {
      "dependsOn": ["lib"]
    },
    "primitives:check": {
      "dependsOn": ["lib"]
    }
  }
}
