{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shopping",
  "targets": {
    "build": {
      "dependsOn": ["^lib"]
    },
    "tsc:typecheck": {
      "executor": "nx:run-script",
      "options": {
        "script": "ts"
      },
      "dependsOn": ["^lib"]
    },
    "preview": {
      "continuous": true,
      "dependsOn": ["build"]
    },
    "dev": {
      "continuous": true,
      "dependsOn": ["^lib", "zerospin:dev"]
    },
    "zerospin:dev": {
      "continuous": true,
      "dependsOn": ["^lib"]
    },
    "deploy:app": {
      "executor": "nx:run-script",
      "options": {
        "script": "deploy:app"
      },
      "dependsOn": ["build"]
    },
    "deploy:zerospin": {
      "executor": "nx:run-script",
      "options": {
        "script": "deploy:zerospin"
      },
      "dependsOn": ["^lib"]
    },
    "agent-preview:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx --tsconfig tsconfig.json src/zerospin/fixtures/purchaseItemAgent.ts",
        "cwd": "examples/shopping"
      }
    },
    "marketplace:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["^lib"],
      "options": {
        "command": "pnpm exec tsx --tsconfig tsconfig.json src/zerospin/fixtures/marketplace.ts",
        "cwd": "examples/shopping"
      }
    }
  }
}
