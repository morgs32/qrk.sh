{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext", "es2021"],
    "declaration": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "incremental": true,
    "composite": false,
    "rootDir": "./src",
    "types": [
      "vite/client",
      "node",
      "./worker-configuration.d.ts",
      "./src/cloudflare-workers.d.ts",
      "vite-plugin-pwa/react"
    ],
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "virtual:pwa-register/react": [
        "./node_modules/vite-plugin-pwa/react.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts"],
  "exclude": ["dist", "node_modules", "**/*.spec.ts", "**/*.spec.tsx"],
  "references": [
    {
      "path": "../../packages/sdk"
    },
    {
      "path": "../../packages/error"
    },
    {
      "path": "../../packages/devtools"
    },
    {
      "path": "../../packages/shared-worker"
    },
    {
      "path": "../../packages/dev-worker"
    },
    {
      "path": "../../packages/cli"
    },
    {
      "path": "../../packages/system-worker"
    },
    {
      "path": "../../packages/react"
    },
    {
      "path": "../../packages/logger"
    },
    {
      "path": "../../packages/core"
    }
  ]
}
