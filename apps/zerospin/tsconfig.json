{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "config": ["./zerospin.config.ts"]
    },
    "exactOptionalPropertyTypes": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": ["src/**/*.ts", "*.ts"],
  "references": [
    {
      "path": "../../vendor/zerospin/packages/system-worker"
    }
  ]
}
