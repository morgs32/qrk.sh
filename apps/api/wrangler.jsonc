{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "./Worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "QRKSH",
      "bucket_name": "qrksh",
    },
    {
      "binding": "ASSETS",
      "bucket_name": "assets",
    },
  ],
  "vars": {
    // Portless exposes local public objects through the API Worker's /assets route.
    "R2_PUBLIC_BASE_URL": "https://api.qrk.localhost/assets",
    "CLERK_AUTHORIZED_PARTY": "https://app.qrk.localhost",
  },
  "browser": { "binding": "BROWSER", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_HOST", "class_name": "BrowserHost" },
      { "name": "BACKEND_REPO", "class_name": "BackendRepo" },
      { "name": "FIGMA_BACKEND", "class_name": "FigmaBackend" },
      { "name": "GOOGLE_PLACES_BACKEND", "class_name": "GooglePlacesBackend" },
      { "name": "LINK_BACKEND", "class_name": "LinkBackend" },
    ],
  },
  "exports": {
    "BrowserHost": { "type": "durable-object", "storage": "sqlite" },
    "BackendRepo": { "type": "durable-object", "storage": "sqlite" },
    "FigmaBackend": { "type": "durable-object", "storage": "sqlite" },
    "GooglePlacesBackend": { "type": "durable-object", "storage": "sqlite" },
    "LinkBackend": { "type": "durable-object", "storage": "sqlite" },
  },
  "env": {
    "production": {
      "name": "qrk-api",
      "account_id": "4b0ca6b8e3a6fe721318c9de65b5f29d",
      "workers_dev": true,
      "routes": [{ "pattern": "api.qrk.sh", "custom_domain": true }],
      "vars": {
        "R2_PUBLIC_BASE_URL": "https://api.qrk.sh/assets",
        "CLERK_AUTHORIZED_PARTY": "https://app.qrk.sh",
      },
      "r2_buckets": [
        { "binding": "QRKSH", "bucket_name": "qrksh" },
        { "binding": "ASSETS", "bucket_name": "assets" },
      ],
      "browser": { "binding": "BROWSER", "remote": true },
      "durable_objects": {
        "bindings": [
          { "name": "BROWSER_HOST", "class_name": "BrowserHost" },
          { "name": "BACKEND_REPO", "class_name": "BackendRepo" },
          { "name": "FIGMA_BACKEND", "class_name": "FigmaBackend" },
          { "name": "GOOGLE_PLACES_BACKEND", "class_name": "GooglePlacesBackend" },
          { "name": "LINK_BACKEND", "class_name": "LinkBackend" },
        ],
      },
      "exports": {
        "BrowserHost": { "type": "durable-object", "storage": "sqlite" },
        "BackendRepo": { "type": "durable-object", "storage": "sqlite" },
        "FigmaBackend": { "type": "durable-object", "storage": "sqlite" },
        "GooglePlacesBackend": { "type": "durable-object", "storage": "sqlite" },
        "LinkBackend": { "type": "durable-object", "storage": "sqlite" },
      },
    },
  },
}
