{
  "name": "@qrk.sh/library",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./BrickBreakpointProvider": {
      "types": "./dist/lib/BrickBreakpointProvider.d.ts",
      "import": "./dist/BrickBreakpointProvider.js"
    },
    "./breakpoints": {
      "types": "./dist/lib/breakpoints.d.ts",
      "import": "./dist/breakpoints.js"
    },
    "./BrickPreview": {
      "types": "./dist/lib/BrickPreview.d.ts",
      "import": "./dist/BrickPreview.js"
    },
    "./BrickWall": {
      "types": "./dist/lib/BrickWall.d.ts",
      "import": "./dist/BrickWall.js"
    },
    "./GridStore": {
      "types": "./dist/lib/GridStore.d.ts",
      "import": "./dist/GridStore.js"
    },
    "./bricks.css": "./dist/bricks.css"
  },
  "scripts": {
    "dev": "vp dev --config vite.workbench.config.ts",
    "preview": "vp preview --config vite.workbench.config.ts --host 127.0.0.1 --port 4100 --strictPort",
    "build": "vp build && cp bricks.css dist/ && mkdir -p dist/worker && cp worker/*.public.d.ts dist/worker/ && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "tsc": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build:app": "vp build --config vite.workbench.config.ts",
    "test:workerd": "vitest run --config vitest.worker.config.ts",
    "types": "wrangler types ./worker-configuration.d.ts",
    "tsc:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cloudflare/puppeteer": "^1.1.0",
    "@json-render/core": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "@qrk.sh/r2-assets": "workspace:*",
    "@qrk.sh/web": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@unpic/react": "1.0.2",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/schema": "workspace:*",
    "capnweb": "^0.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "rc",
    "es-toolkit": "^1.45.1",
    "json-edit-react": "^1.30.2",
    "lucide-react": "^1.7.0",
    "mapbox-gl": "^3.18.1",
    "react-activity-calendar": "^3.2.1",
    "react-colorful": "^5.8.1",
    "react-grid-layout": "^2.2.3",
    "react-json-view-lite": "^2.5.0",
    "swr": "^2.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
