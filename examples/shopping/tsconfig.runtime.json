{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "./src/cloudflare-workers.d.ts",
      "@cloudflare/vitest-plugin/types"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "config": ["../../packages/system-worker/src/config.d.ts"],
      "virtual:pwa-register/react": [
        "./node_modules/vite-plugin-pwa/react.d.ts"
      ]
    }
  },
  "include": [
    "test/**/*.ts",
    "../../packages/system-worker/env-types.d.ts",
    "../../packages/system-worker/src/inMemorySessionGuard.wasm.d.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "references": []
}
