{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"],
    "paths": {
      "config": ["./zerospin.config.ts"]
    },
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.ts", "*.ts"]
}
