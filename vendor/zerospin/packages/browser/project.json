{
  "name": "@zerospin/browser",
  "targets": {
    "lib": {
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/backup-worker",
            "@zerospin/core",
            "@zerospin/devtools",
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/schema",
            "system-worker"
          ]
        }
      ]
    },
    "agent-preview:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["lib"],
      "options": {
        "command": "pnpm exec tsx src/fixtures/agentPreview.ts",
        "cwd": "packages/browser"
      }
    }
  }
}
