{
  "extends": ["../../.oxlintrc.json"],
  "overrides": [
    {
      "files": ["**/*"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/src/**"],
                "message": "Do not import from any /src/ path. Use the owning package alias or public entrypoint instead."
              }
            ]
          }
        ]
      }
    }
  ],
  "globals": {
    "Blob": "readonly",
    "File": "readonly",
    "FormData": "readonly",
    "Headers": "readonly",
    "Request": "readonly",
    "Response": "readonly",
    "URL": "readonly",
    "URLSearchParams": "readonly",
    "WebSocketPair": "readonly",
    "Worker": "readonly",
    "console": "readonly",
    "crypto": "readonly",
    "describe": "readonly",
    "document": "readonly",
    "expect": "readonly",
    "fetch": "readonly",
    "IntersectionObserver": "readonly",
    "it": "readonly",
    "localStorage": "readonly",
    "navigator": "readonly",
    "process": "readonly",
    "sessionStorage": "readonly",
    "setTimeout": "readonly",
    "vi": "readonly",
    "window": "readonly",
    "Buffer": "readonly"
  },
  "env": {
    "browser": true,
    "node": true,
    "vitest": true
  }
}
