      "types": "./dist/DevWorker.d.ts",
      "import": "./dist/DevWorker.js",
      "default": "./dist/DevWorker.js"
    },
    "./shims/makeMigratedInMemoryWasmSqliteDb": {
      "types": "./dist/shims/makeMigratedInMemoryWasmSqliteDb.d.ts",
      "import": "./dist/shims/makeMigratedInMemoryWasmSqliteDb.js",
      "default": "./dist/shims/makeMigratedInMemoryWasmSqliteDb.js"
    },
