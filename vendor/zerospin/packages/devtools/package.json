{
  "name": "@zerospin/devtools",
  "version": "2.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "types": "./dist/types.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/live-query": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "effect": "^3.21.4",
    "react-router": "^7.15.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": ">=18",
    "react-dom": ">=18",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
