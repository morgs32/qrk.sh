{
  "name": "@qrk.sh/zerospin",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint . --format stylish",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "types": "wrangler types ./worker-configuration.d.ts -c wrangler.vitest.jsonc",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.5",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/schema": "workspace:*",
    "@zerospin/sdk": "workspace:*",
    "capnweb": "^0.12.0",
    "effect": "rc",
    "system-worker": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "rc",
    "@types/node": "^25.5.2",
    "@zerospin/dev-worker": "workspace:*",
    "cloudflare": "^6.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "oxlint": "^1.59.0",
    "system": "workspace:*",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.127.1"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^lib"
        ]
      },
      "test:workerd": {
        "dependsOn": [
          "^lib"
        ]
      }
    }
  }
}
