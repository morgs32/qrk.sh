{
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "worker/**/*.ts",
    "modules/**/[A-Z]*Repo.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["worker/**/*.e2e.spec.ts", "node_modules"]
}
