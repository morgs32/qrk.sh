{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qrk-sh-e2e",
  "main": "./src/Worker.ts",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  "durable_objects": {
    "bindings": [
      { "name": "ACTOR_REPO", "class_name": "ActorRepo" },
      { "name": "SYSTEM_REPO", "class_name": "SystemRepo" },
      { "name": "ACCOUNT_REPO", "class_name": "AccountRepo" },
      { "name": "SERVICE_REPO", "class_name": "ServiceRepo" },
      { "name": "ACCOUNT_BLOCK_REPO", "class_name": "AccountBlockRepo" },
      { "name": "ACTOR_BLOCK_REPO", "class_name": "ActorBlockRepo" },
      { "name": "FRONTEND_REPO", "class_name": "FrontendRepo" },
      { "name": "FRONTEND_BLOCK_REPO", "class_name": "FrontendBlockRepo" },
      { "name": "SERVICE_BLOCK_REPO", "class_name": "ServiceBlockRepo" },
      { "name": "AUTHORIZATION_REPO", "class_name": "AuthorizationRepo" },
      { "name": "SYSTEM_LOG_REPO", "class_name": "SystemLogRepo" },
      { "name": "SYSTEM_LOG_AGENT", "class_name": "SystemLogAgent" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ActorRepo",
        "SystemRepo",
        "AccountRepo",
        "ServiceRepo",
        "AccountBlockRepo",
        "ActorBlockRepo",
        "AuthorizationRepo",
        "SystemLogRepo",
        "SystemLogAgent",
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["FrontendRepo", "FrontendBlockRepo", "ServiceBlockRepo"],
    },
  ],
  "vars": {
    "TESTING": true,
    "CLERK_AUTHORIZED_PARTY": "http://localhost:4000",
    "CLERK_SECRET_KEY": "sk_test_qrk_workerd",
    "ZEROSPIN_ENVIRONMENT_ID": "zerospin-dev",
    "ZEROSPIN_SYSTEM_ID": "sys_qrk_sh_1",
    "ZEROSPIN_SYSTEM_VERSION": "2.0.0",
  },
  "alias": {
    "@zerospin/core/drizzle/makeMigratedInMemoryWasmSqliteDbAdapter": "./src/shims/makeMigratedInMemoryWasmSqliteDbAdapter.ts",
    "system": "./src/system.ts",
  },
}
