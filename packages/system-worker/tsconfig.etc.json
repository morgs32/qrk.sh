{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": [
      "@cloudflare/vitest-plugin/types",
      "node",
      "vite/client",
      "vitest/globals",
      "./worker-configuration.d.ts"
    ],
    "paths": {
      "config": ["../fixtures/src/config/config.ts"]
    },
    "composite": false,
    "incremental": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "vitest-env.d.ts",
    "worker-configuration.d.ts",
    "env-types.d.ts",
    "vitest.node.config.ts",
    "vitest.workerd.config.ts"
  ],
  "exclude": [],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/error"
    },
    {
      "path": "../fixtures/tsconfig.config.json"
    }
  ]
}
