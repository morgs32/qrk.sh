{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "rootDir": ".",
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.typecheck.ts",
    "src/**/*.typecheck.tsx",
    "vitest.config.ts"
  ],
  "exclude": [],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../error"
    },
    {
      "path": "../logger"
    }
  ]
}
