{
  "name": "@zerospin/cli",
  "version": "2.0.1",
  "private": false,
  "bin": {
    "zerospin": "./dist/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/types.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "prepublishOnly": "pnpm run lib",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest"
  },
  "dependencies": {
    "@effect/platform-node-shared": "rc",
    "@inkjs/ui": "^2.0.0",
    "@zerospin/core": "workspace:*",
    "@zerospin/dev-worker": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/production-worker": "workspace:*",
    "@zerospin/schema": "workspace:*",
    "@zerospin/studio": "workspace:*",
    "capnweb": "^0.12.0",
    "cfonts": "^2.10.1",
    "dotenv": "^17.4.2",
    "ink": "^7.0.2",
    "ink-gradient": "^3.0.0",
    "jiti": "^2.7.0",
    "nanoid": "^5.1.11",
    "pastel": "^4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "system-worker": "workspace:*",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "rc",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "effect": "rc",
    "oxlint": "^1.63.0",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.111"
  },
  "engines": {
    "node": ">=18"
  }
}
