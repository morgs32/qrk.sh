{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "library",
  "main": "./worker/Worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc", "/upload", "/assets/*"],
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "assets",
    },
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "/assets",
  },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_HOST", "class_name": "BrowserHost" },
      { "name": "INSTAGRAM_BACKEND", "class_name": "InstagramBackend" },
      { "name": "GITHUB_BACKEND", "class_name": "GitHubBackend" },
      { "name": "FIGMA_BACKEND", "class_name": "FigmaBackend" },
      { "name": "GOOGLE_PLACES_BACKEND", "class_name": "GooglePlacesBackend" },
      { "name": "LINK_BACKEND", "class_name": "LinkBackend" },
      { "name": "STREAMLINE_BACKEND", "class_name": "StreamlineBackend" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["BrowserHost", "StreamlineRepo"],
      "new_sqlite_classes": [
        "InstagramRepo",
        "GitHubRepo",
        "TikTokRepo",
        "FigmaRepo",
        "GooglePlacesRepo",
        "LinkRepo",
      ],
    },
    {
      "tag": "v2",
      "renamed_classes": [
        { "from": "StreamlineRepo", "to": "StreamlineBackend" },
        { "from": "InstagramRepo", "to": "InstagramBackend" },
        { "from": "GitHubRepo", "to": "GitHubBackend" },
        { "from": "TikTokRepo", "to": "TikTokBackend" },
        { "from": "FigmaRepo", "to": "FigmaBackend" },
        { "from": "GooglePlacesRepo", "to": "GooglePlacesBackend" },
        { "from": "LinkRepo", "to": "LinkBackend" },
      ],
    },
    {
      "tag": "v3",
      "deleted_classes": ["TikTokBackend"],
    },
  ],
}
