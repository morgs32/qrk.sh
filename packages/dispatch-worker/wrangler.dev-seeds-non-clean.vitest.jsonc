{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zerospin-dispatch-worker-dev-seeds-non-clean-test",
  "main": "./tests/workerd/SelfHostedZerospinApis.fixture.worker.ts",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  "durable_objects": {
    "bindings": [
      { "name": "ACTOR_REPO", "class_name": "ActorRepo" },
      { "name": "SYSTEM_REPO", "class_name": "SystemRepo" },
      { "name": "ACCOUNT_REPO", "class_name": "AccountRepo" },
      { "name": "SERVICE_REPO", "class_name": "ServiceRepo" },
      { "name": "ACCOUNT_BLOCK_REPO", "class_name": "AccountBlockRepo" },
      { "name": "ACTOR_BLOCK_REPO", "class_name": "ActorBlockRepo" },
      { "name": "FRONTEND_REPO", "class_name": "FrontendRepo" },
      { "name": "FRONTEND_BLOCK_REPO", "class_name": "FrontendBlockRepo" },
      { "name": "SERVICE_BLOCK_REPO", "class_name": "ServiceBlockRepo" },
      {
        "name": "SERVICE_FRONTEND_REPO",
        "class_name": "ServiceFrontendRepo",
      },
      {
        "name": "SERVICE_FRONTEND_BLOCK_REPO",
        "class_name": "ServiceFrontendBlockRepo",
      },
      { "name": "AUTHORIZATION_REPO", "class_name": "AuthorizationRepo" },
      { "name": "SYSTEM_LOG_REPO", "class_name": "SystemLogRepo" },
      { "name": "SYSTEM_LOG_AGENT", "class_name": "SystemLogAgent" },
      {
        "name": "SELF_HOSTED_ZEROSPIN_APIS",
        "class_name": "SelfHostedZerospinApis",
      },
    ],
  },
  "migrations": [
    {
      "tag": "zerospin-self-hosted-v1",
      "new_sqlite_classes": ["SelfHostedZerospinApis"],
    },
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ActorRepo",
        "SystemRepo",
        "AccountRepo",
        "ServiceRepo",
        "AccountBlockRepo",
        "ActorBlockRepo",
        "AuthorizationRepo",
        "SystemLogRepo",
        "SystemLogAgent",
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "FrontendRepo",
        "FrontendBlockRepo",
        "ServiceBlockRepo",
      ],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ServiceFrontendRepo", "ServiceFrontendBlockRepo"],
    },
  ],
  "version_metadata": {
    "binding": "ZEROSPIN_VERSION_METADATA",
  },
  "vars": {
    "TESTING": true,
    "ZEROSPIN_INSTANCE_ID": "production",
    "ZEROSPIN_PUBLISHABLE_KEY": "pk_live_self_hosted_test",
    "ZEROSPIN_SELF_HOSTED": "true",
    "ZEROSPIN_SECRET_KEY": "sk_live_self_hosted_test",
    "ZEROSPIN_SYSTEM_ID": "sys_local",
  },
}
