{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/cli",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/core",
            "@zerospin/dev-worker",
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/production-worker",
            "@zerospin/schema",
            "@zerospin/studio",
            "system-worker"
          ]
        },
        {
          "target": "config:lib",
          "projects": ["@zerospin/fixtures"]
        }
      ]
    },
    "watch": {
      "continuous": true
    }
  }
}
