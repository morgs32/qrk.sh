{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/core",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/schema",
            "@zerospin/server-only"
          ]
        }
      ]
    },
    "watch": {
      "continuous": true
    },
    "dev": {
      "continuous": true
    },
    "agent-preview:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["lib"],
      "options": {
        "command": "pnpm exec tsx src/agent/fixtures/agentDeclarations.ts",
        "cwd": "packages/core"
      }
    },
    "node-outcomes:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["lib"],
      "options": {
        "command": "pnpm exec tsx src/Node/fixtures/commandOutcomes.ts",
        "cwd": "packages/core"
      }
    }
  }
}
