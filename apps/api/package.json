{
  "name": "@qrk.sh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "wrangler dev --ip 127.0.0.1 --port ${PORT:-8787} --inspector-port 0",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types ./worker-configuration.d.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.5",
    "@cloudflare/puppeteer": "^1.1.0",
    "@json-render/core": "^0.20.0",
    "@qrk.sh/r2-assets": "workspace:*",
    "@qrk.sh/zerospin": "workspace:*",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/core": "26.0.2",
    "@zerospin/error": "26.0.2",
    "@zerospin/logger": "26.0.2",
    "@zerospin/shapes": "26.0.2",
    "capnweb": "^0.12.0",
    "drizzle-orm": "npm:@zerospin/drizzle-orm@1.0.0-rc.5-qrk.3",
    "effect": "4.0.2",
    "es-toolkit": "^1.52.0",
    "system-worker": "26.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "wrangler": "4.131.2"
  },
  "portless": {
    "name": "api.qrk",
    "script": "dev:app",
    "appPort": 8787,
    "proxy": true
  }
}
