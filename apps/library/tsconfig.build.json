{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "app/**",
    "scraper/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "vite*.ts",
    "vitest*.ts",
    "dist",
    "build",
    "node_modules",
    "test-results"
  ]
}
