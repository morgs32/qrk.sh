{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@qrk.sh/library",
  "targets": {
    "dev": {
      "continuous": true,
      "dependsOn": ["^lib", { "projects": ["@qrk.sh/api"], "target": "dev" }]
    },
    "preview": {
      "continuous": true,
      "dependsOn": [{ "projects": ["@qrk.sh/api"], "target": "dev" }]
    },
    "tsc": {
      "dependsOn": ["^lib"]
    },
    "build": {
      "dependsOn": ["^lib"]
    },
    "build:app": {
      "dependsOn": ["^lib"]
    }
  }
}
