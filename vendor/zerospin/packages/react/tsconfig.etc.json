{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts"],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../core"
    },
    {
      "path": "../error"
    },
    {
      "path": "../devtools"
    },
    {
      "path": "../browser"
    },
    {
      "path": "../logger"
    }
  ],
  "exclude": []
}
