{
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["workerd"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": ["*.ts", "*.d.ts"],
  "exclude": ["node_modules", ".wrangler"]
}
