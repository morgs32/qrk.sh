{
  "name": "@zerospin/production-worker",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src"],
  "exports": {
    "./ProductionWorker": {
      "types": "./dist/ProductionWorker.d.ts",
      "import": "./dist/ProductionWorker.js",
      "default": "./dist/ProductionWorker.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "test:workerd": "vitest run --config vitest.production.config.ts",
    "ts": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "capnweb": "^0.7.0",
    "cloudflare": "^6.1.0",
    "effect": "^3.21.4",
    "system": "workspace:*",
    "system-worker": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@types/node": "^25.9.4",
    "@zerospin/dev-worker": "workspace:*",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.5"
  }
}
