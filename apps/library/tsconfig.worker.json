{
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "@cloudflare/vitest-pool-workers"]
  },
  "include": [
    "scraper/**/*.ts",
    "modules/**/[A-Z]*Repo.ts",
    "cloudflare-test.d.ts",
    "worker-configuration.d.ts"
  ]
}
