{
  "extends": ["../../.oxlintrc.json"],
  "overrides": [
    {
      "files": ["src/types.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "Blob": "readonly",
    "File": "readonly",
    "FormData": "readonly",
    "Headers": "readonly",
    "Request": "readonly",
    "Response": "readonly",
    "URL": "readonly",
    "URLSearchParams": "readonly",
    "WebSocketPair": "readonly",
    "Worker": "readonly",
    "console": "readonly",
    "crypto": "readonly",
    "describe": "readonly",
    "document": "readonly",
    "expect": "readonly",
    "fetch": "readonly",
    "IntersectionObserver": "readonly",
    "it": "readonly",
    "localStorage": "readonly",
    "navigator": "readonly",
    "process": "readonly",
    "sessionStorage": "readonly",
    "setTimeout": "readonly",
    "vi": "readonly",
    "window": "readonly"
  }
}
