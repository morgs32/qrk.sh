{
  "name": "@zerospin/sync",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Agents read-only DO state sync spike",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "agents": "^0.17.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.17",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "capnweb": "^0.12.0",
    "cloudflare": "^6.1.0",
    "effect": "rc",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "^6.1.3",
    "wrangler": "^4.127.1"
  }
}
