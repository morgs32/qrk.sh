{
  "name": "@qrk.sh/zerospin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "zerospin dev --port ${PORT:-8788}"
  },
  "portless": {
    "name": "zerospin.qrk",
    "script": "dev:app",
    "appPort": 8788,
    "proxy": true
  },
  "dependencies": {
    "@clerk/backend": "^3.8.5",
    "@qrk.sh/library": "workspace:*",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/core": "19.0.0",
    "@zerospin/error": "19.0.0",
    "@zerospin/logger": "19.0.0",
    "@zerospin/sdk": "19.0.0",
    "@zerospin/shapes": "19.0.0",
    "capnweb": "^0.12.0",
    "effect": "4.0.2",
    "system-worker": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@zerospin/cli": "19.0.0",
    "@zerospin/dev-worker": "19.0.0",
    "cloudflare": "^6.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "typescript": "^6.0.2",
    "wrangler": "^4.127.1"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true
      }
    }
  }
}
