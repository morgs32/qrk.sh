{
  "name": "@zerospin/studio",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/startStudio.*",
    "src",
    "index.html",
    "vite.config.ts"
  ],
  "exports": {
    "./startStudio": {
      "types": "./dist/startStudio.d.ts",
      "import": "./dist/startStudio.js",
      "default": "./dist/startStudio.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.etc.json --noEmit",
    "prepublishOnly": "pnpm run lib",
    "format": "oxfmt package.json project.json tsconfig.json tsconfig.etc.json vite.config.ts src",
    "format:check": "oxfmt --check package.json project.json tsconfig.json tsconfig.etc.json vite.config.ts src",
    "lint": "oxlint . --format stylish",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.21.4",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-json-view-lite": "^2.5.0",
    "react-resizable-panels": "^4.12.1",
    "react-router": "^8.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.11"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "@zerospin/dispatch-worker": "workspace:*",
    "jsdom": "^29.1.1",
    "oxlint": "^1.63.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  }
}
