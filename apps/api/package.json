{
  "name": "@qrk.sh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --inspector-port 9231",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "vp lint --config ../../.oxlintrc.json .",
    "ts": "tsc -p tsconfig.json --noEmit",
    "types": "wrangler types ./worker-configuration.d.ts",
    "test:workerd": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.5",
    "@cloudflare/puppeteer": "^1.1.0",
    "@json-render/core": "^0.20.0",
    "@qrk.sh/library": "workspace:*",
    "@qrk.sh/r2-assets": "workspace:*",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/core": "4.0.2",
    "@zerospin/error": "4.0.2",
    "@zerospin/logger": "4.0.2",
    "@zerospin/shapes": "4.0.2",
    "capnweb": "^0.12.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.2",
    "system-worker": "4.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@types/node": "^25.5.2",
    "@vitest/snapshot": "4.1.11",
    "@vitest/utils": "4.1.11",
    "typescript": "^6.0.2",
    "vite-plus": "1.0.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}
