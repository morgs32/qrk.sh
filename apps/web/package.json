{
  "name": "@qrk.sh/web",
  "private": true,
  "exports": {
    "./components/UnderlinedLink": "./components/UnderlinedLink.tsx",
    "./library/OrderedBody": "./library/OrderedBody.tsx",
    "./library/OrderedDoc": "./library/OrderedDoc.tsx",
    "./library/OrderedOutline": "./library/OrderedOutline.tsx"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev --turbopack --port ${PORT:-10000}",
    "build": "next build",
    "start": "next start --port ${PORT:-10011}",
    "format": "vp fmt --config ../../.oxfmtrc.json .",
    "storybook": "PORTLESS_PORT=443 PORTLESS_HTTPS=1 PORTLESS_WILDCARD=1 portless storybook.web.qrk --app-port ${PORT:-10022} storybook dev -p ${PORT:-10022} --host 127.0.0.1",
    "build-storybook": "storybook build",
    "lint": "eslint \"app/{privacy,terms,sign-in,sign-up}/**/*.tsx\""
  },
  "portless": {
    "name": "qrk",
    "script": "dev:app",
    "proxy": true
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.1.0",
    "@fontsource/silkscreen": "^5.2.7",
    "@qrk.sh/bricks": "workspace:*",
    "@qrk.sh/zerospin": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zerospin/core": "1.0.0-alpha.1",
    "@zerospin/sdk": "1.0.0-alpha.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "effect": "4.0.2",
    "framer-motion": "13.2.0",
    "next": "^16.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.5",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^check-imports"
        ]
      },
      "build-storybook": {
        "dependsOn": [
          "^check-imports"
        ]
      }
    }
  }
}
