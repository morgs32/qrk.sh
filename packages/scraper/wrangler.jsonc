{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scraper",
  "main": "./src/Worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_HOST", "class_name": "BrowserHost" },
      { "name": "LINKTREE_REPO", "class_name": "LinktreeRepo" },
      { "name": "BEACONS_REPO", "class_name": "BeaconsRepo" },
      { "name": "INSTAGRAM_REPO", "class_name": "InstagramRepo" },
      { "name": "GITHUB_REPO", "class_name": "GitHubRepo" },
      { "name": "FIGMA_REPO", "class_name": "FigmaRepo" },
      { "name": "GOOGLE_PLACES_REPO", "class_name": "GooglePlacesRepo" },
      { "name": "LINK_REPO", "class_name": "LinkRepo" },
      { "name": "TIKTOK_REPO", "class_name": "TikTokRepo" },
      { "name": "YOUTUBE_REPO", "class_name": "YouTubeRepo" },
      { "name": "TRUTH_SOCIAL_REPO", "class_name": "TruthSocialRepo" },
      { "name": "STREAMLINE_REPO", "class_name": "StreamlineRepo" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScraperRepo"] },
    {
      "tag": "v2",
      "new_classes": ["BrowserHost"],
      "new_sqlite_classes": [
        "LinktreeRepo",
        "BeaconsRepo",
        "InstagramRepo",
        "GitHubRepo",
        "TikTokRepo",
        "YouTubeRepo",
        "TruthSocialRepo",
      ],
      "deleted_classes": ["ScraperRepo"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["FigmaRepo"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["GooglePlacesRepo"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["LinkRepo"],
    },
    {
      "tag": "v6",
      "new_classes": ["StreamlineRepo"],
    },
  ],
}
