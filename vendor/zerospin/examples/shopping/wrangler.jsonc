{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zerospin-shopping",
  "main": "./src/Worker.ts",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "system": "./src/zerospin/system.ts",
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [
      { "name": "SYSTEM_REPO", "class_name": "SystemRepo" },
      { "name": "AGGREGATE_REPO", "class_name": "AggregateRepo" },
      { "name": "SERVICE_REPO", "class_name": "ServiceRepo" },
      {
        "name": "AGGREGATE_BLOCK_REPO",
        "class_name": "AggregateBlockRepo",
      },
      {
        "name": "AGGREGATE_FRONTEND_REPO",
        "class_name": "AggregateFrontendRepo",
      },
      {
        "name": "AGGREGATE_FRONTEND_BLOCK_REPO",
        "class_name": "AggregateFrontendBlockRepo",
      },
      { "name": "SERVICE_BLOCK_REPO", "class_name": "ServiceBlockRepo" },
      {
        "name": "SERVICE_FRONTEND_REPO",
        "class_name": "ServiceFrontendRepo",
      },
      {
        "name": "SERVICE_FRONTEND_BLOCK_REPO",
        "class_name": "ServiceFrontendBlockRepo",
      },
      { "name": "SYSTEM_LOG_REPO", "class_name": "SystemLogRepo" },
      { "name": "SYSTEM_LOG_AGENT", "class_name": "SystemLogAgent" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SystemRepo",
        "AggregateRepo",
        "ServiceRepo",
        "AggregateBlockRepo",
        "AggregateFrontendRepo",
        "AggregateFrontendBlockRepo",
        "ServiceBlockRepo",
        "ServiceFrontendRepo",
        "ServiceFrontendBlockRepo",
        "SystemLogRepo",
        "SystemLogAgent",
      ],
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "version_metadata": {
    "binding": "WORKER_VERSION_METADATA",
  },
  "vars": {
    "TESTING": false,
    "ZEROSPIN_ENVIRONMENT": "dev",
    "ZEROSPIN_SYSTEM_ID": "sys_shopping",
  },
}
