{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/react",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/backup-worker",
            "@zerospin/browser",
            "@zerospin/core",
            "@zerospin/devtools",
            "@zerospin/error",
            "@zerospin/live-query",
            "@zerospin/logger",
            "@zerospin/schema",
            "@zerospin/sdk"
          ]
        }
      ]
    },
    "watch": {
      "continuous": true
    }
  }
}
