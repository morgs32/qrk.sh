{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "include": ["files", "exports", "types"],
  "ignore": [
    "vendor/**",
    "wiki/**",
    "**/*.config.{js,cjs,mjs,ts,tsx}",
    "**/*GlobalSetup.{js,cjs,mjs,ts,tsx}",
    ".agents/skills/**",
    ".github/skills/**",
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "**/components/ui/**": ["exports"],
    "examples/shopping/src/components/ui/**": ["exports"],
    "packages/system-worker/src/types.ts": ["types"],
  },
  "workspaces": {
    ".": {
      "entry": ["nx.json", ".github/workflows/*.yml"],
      "ignoreDependencies": [
        "@changesets/cli",
        "@zerospin/cli",
        "madge",
        "react",
        "react-dom",
        "rimraf",
        "tsafe",
        "tslib",
      ],
    },
    "examples/shopping": {
      "entry": [
        "src/zerospin/session.worker.ts",
        "zerospin.config.ts",
        "src/zerospin/system.ts",
        "src/zerospin/seeds.ts",
        "src/zerospin/models.ts",
      ],
      "ignoreFiles": [],
      "next": true,
    },
    "examples/parking": {
      "entry": [
        "src/zerospin/provider.session.worker.ts",
        "src/zerospin/owner.session.worker.ts",
        "zerospin.config.ts",
        "src/zerospin/system.ts",
        "src/zerospin/seeds.ts",
        "src/zerospin/models.ts",
        "src/zerospin/sessions.ts",
      ],
      "ignoreFiles": [],
      "next": true,
    },
    "packages/core": {
      "entry": [
        "src/**!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.ts!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.tsx!",
      ],
      "project": [
        "src/**!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.ts!",
        "!**/*.{spec,node.spec,typecheck,bench,test,test-d,spec-d,d}.tsx!",
      ],
    },
    "packages/cli": {
      "entry": ["src/cli.tsx", "src/commands/**/*.tsx", "src/commands/**/*.ts"],
    },
    "packages/dev-worker": {
      "entry": ["src/DevWorker.ts", "src/emptySeeds.ts"],
    },
    "packages/production-worker": {
      "entry": ["src/emptySeeds.ts"],
    },
    "packages/devtools": {
      "entry": [
        "src/ZerospinDevtools.tsx",
        "src/types.ts",
        "src/zerospinDevtoolsStore.ts",
      ],
    },
    "packages/live-query": {
      "entry": ["src/makeLiveQuery.ts"],
    },
    "packages/logger": {
      "entry": ["specs/workerd/finalizeAccountCommands/SystemApi.ts"],
    },
    "packages/error": {
      "entry": ["src/index.ts"],
    },
    "packages/react": {
      "entry": ["src/index.ts", "src/primitives.ts"],
    },
    "packages/sdk": {
      "entry": ["src/index.ts"],
    },
    "packages/system": {
      "entry": ["src/index.ts"],
    },
    "packages/sync": {
      "entry": [],
    },
    "packages/system-worker": {
      "entry": [],
      "paths": {
        "config": [],
      },
      "ignore": ["worker.d.ts"],
      "ignoreFiles": [],
      "wrangler": {
        "config": ["wrangler.jsonc"],
      },
    },
  },
}
