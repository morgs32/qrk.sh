{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "system-worker-machine-test",
  "main": "tests/workerd/machines/TestWorker.ts",
  "compatibility_date": "2025-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "OUTBOX_SENDER_FIXTURE", "class_name": "OutboxSenderFixture" },
      {
        "name": "OUTBOX_RECEIVER_FIXTURE",
        "class_name": "OutboxReceiverFixture",
      },
      { "name": "FIXTURE_REPO", "class_name": "FixtureRepo" },
      {
        "name": "FIXED_DO_REPO_FIXTURE",
        "class_name": "FixedDORepoFixture",
      },
      {
        "name": "VERSIONED_DO_REPO_FIXTURE",
        "class_name": "MigratableDORepoFixture",
      },
      { "name": "SYSTEM_REPO", "class_name": "SystemRepo" },
      {
        "name": "AGGREGATE_MACHINE_REPO",
        "class_name": "AggregateMachineRepo",
      },
      { "name": "SERVICE_MACHINE_REPO", "class_name": "ServiceMachineRepo" },
      {
        "name": "AGGREGATE_VERSION_REPO",
        "class_name": "AggregateVersionRepo",
      },
      {
        "name": "SERVICE_VERSION_REPO",
        "class_name": "ServiceVersionRepo",
      },
      {
        "name": "AGGREGATE_CHAIN",
        "class_name": "AggregateChain",
      },
      {
        "name": "AGGREGATE_VERSION_CHAIN",
        "class_name": "AggregateVersionChain",
      },
      {
        "name": "SERVICE_VERSION_CHAIN",
        "class_name": "ServiceVersionChain",
      },
      {
        "name": "AGGREGATE_ACTOR_VERSION_REPO",
        "class_name": "AggregateActorVersionRepo",
      },
      {
        "name": "AGGREGATE_ACTOR_VERSION_CHAIN",
        "class_name": "AggregateActorVersionChain",
      },
      {
        "name": "SERVICE_CHAIN",
        "class_name": "ServiceChain",
      },
      {
        "name": "SERVICE_ACTOR_VERSION_REPO",
        "class_name": "ServiceActorVersionRepo",
      },
      {
        "name": "SERVICE_ACTOR_VERSION_CHAIN",
        "class_name": "ServiceActorVersionChain",
      },
      { "name": "SYSTEM_LOG_REPO", "class_name": "SystemLogRepo" },
      { "name": "SYSTEM_LOG_AGENT", "class_name": "SystemLogAgent" },
    ],
  },
  "exports": {
    "OutboxSenderFixture": { "type": "durable-object", "storage": "sqlite" },
    "OutboxReceiverFixture": { "type": "durable-object", "storage": "sqlite" },
    "FixtureRepo": { "type": "durable-object", "storage": "sqlite" },
    "FixedDORepoFixture": { "type": "durable-object", "storage": "sqlite" },
    "MigratableDORepoFixture": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SystemRepo": { "type": "durable-object", "storage": "sqlite" },
    "AggregateMachineRepo": { "type": "durable-object", "storage": "sqlite" },
    "ServiceMachineRepo": { "type": "durable-object", "storage": "sqlite" },
    "AggregateVersionRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ServiceVersionRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AggregateChain": { "type": "durable-object", "storage": "sqlite" },
    "AggregateVersionChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ServiceVersionChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AggregateActorVersionRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AggregateActorVersionChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ServiceChain": { "type": "durable-object", "storage": "sqlite" },
    "ServiceActorVersionRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ServiceActorVersionChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SystemLogRepo": { "type": "durable-object", "storage": "sqlite" },
    "SystemLogAgent": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": {
    "ZEROSPIN_ENVIRONMENT": "dev",
    "ZEROSPIN_SYSTEM_ID": "sys_machine_test",
  },
}
