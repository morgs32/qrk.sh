{
  "name": "parking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p ${PORT:-3011}",
    "worker:dev": "wrangler dev -c ./wrangler.jsonc --host 0.0.0.0 --port 3006",
    "deploy": "wrangler deploy -c ./wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run -c ./wrangler.jsonc",
    "types": "wrangler types -c ./wrangler.jsonc",
    "ts": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.etc.json --noEmit",
    "lint": "oxlint . --format stylish",
    "test": "vitest",
    "test:playwright": "playwright test --config e2e.playwright.config.ts",
    "test:playwright:ui": "playwright test --config e2e.playwright.config.ts --ui",
    "test:workerd": "vitest run --config vitest.zerospin.config.ts",
    "start": "next start"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@vercel/analytics": "2.0.1",
    "@zerospin/core": "workspace:*",
    "@zerospin/devtools": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/react": "workspace:*",
    "@zerospin/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.21.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@clerk/testing": "^1.13.35",
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "4.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@zerospin/dispatch-worker": "workspace:*",
    "capnweb": "^0.7.0",
    "cloudflare": "^6.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.17-67b1795",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "postcss-load-config": "^6.0.1",
    "system-worker": "workspace:*",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "~4.1.5",
    "wrangler": "^4.90.0"
  }
}
