{
  "name": "@qrk.sh/zerospin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zerospin dev --port 8788",
    "lint": "vp lint --config ../../.oxlintrc.json . --format stylish",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "ts": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.5",
    "@qrk.sh/library": "workspace:*",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/core": "7.0.0",
    "@zerospin/error": "7.0.0",
    "@zerospin/logger": "7.0.0",
    "@zerospin/sdk": "7.0.0",
    "@zerospin/shapes": "7.0.0",
    "capnweb": "^0.12.0",
    "effect": "4.0.2",
    "system-worker": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@effect/vitest": "4.0.2",
    "@livestore/wa-sqlite": "^1.0.5",
    "@types/node": "^25.5.2",
    "@zerospin/cli": "7.0.0",
    "@zerospin/dev-worker": "7.0.0",
    "cloudflare": "^6.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "typescript": "^6.0.2",
    "vite-plus": "1.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.127.1"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "dependsOn": [
          {
            "projects": [
              "@qrk.sh/library"
            ],
            "target": "build"
          }
        ]
      },
      "test:workerd": {
        "dependsOn": [
          {
            "projects": [
              "@qrk.sh/library"
            ],
            "target": "build"
          }
        ]
      },
      "ts": {
        "dependsOn": [
          {
            "projects": [
              "@qrk.sh/library"
            ],
            "target": "build"
          }
        ]
      }
    }
  }
}
