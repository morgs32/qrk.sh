CLERK_AUTHORIZED_PARTY=https://app.qrk.localhost
# Set CLERK_SECRET_KEY in .env.local for local authentication.

# Required full LibraryApi RPC endpoint for recorded brick-spec generation.
QRK_LIBRARY_API_URL=https://api.qrk.localhost/rpc

# Instagram verification: use the same public receiver values in App and API.
# Set these after creating the professional account; do not use a fabricated ID.
# NEXT_PUBLIC_INSTAGRAM_RECEIVING_ACCOUNT_ID=
# NEXT_PUBLIC_INSTAGRAM_RECEIVING_USERNAME=
# Set private INSTAGRAM_ACCESS_TOKEN in .env.local and choose the API version
# supported by the configured Meta app (for example its displayed vN.N value).
# INSTAGRAM_GRAPH_API_VERSION=
