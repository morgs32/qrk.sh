{
  "name": "@zerospin/browser",
  "version": "2.0.1",
  "private": false,
  "description": "Zerospin browser sessions, runtimes, transport, and backups",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./fetchAggregateSessionSnapshot": {
      "types": "./dist/fetchAggregateSessionSnapshot.d.ts",
      "import": "./dist/fetchAggregateSessionSnapshot.js",
      "default": "./dist/fetchAggregateSessionSnapshot.js"
    },
    "./createAggregateSessionWebSocketTicket": {
      "types": "./dist/createAggregateSessionWebSocketTicket.d.ts",
      "import": "./dist/createAggregateSessionWebSocketTicket.js",
      "default": "./dist/createAggregateSessionWebSocketTicket.js"
    },
    "./fetchServiceSessionSnapshot": {
      "types": "./dist/fetchServiceSessionSnapshot.d.ts",
      "import": "./dist/fetchServiceSessionSnapshot.js",
      "default": "./dist/fetchServiceSessionSnapshot.js"
    },
    "./createServiceSessionWebSocketTicket": {
      "types": "./dist/createServiceSessionWebSocketTicket.d.ts",
      "import": "./dist/createServiceSessionWebSocketTicket.js",
      "default": "./dist/createServiceSessionWebSocketTicket.js"
    },
    "./makeStandaloneSessionBackupKey": {
      "types": "./dist/makeStandaloneSessionBackupKey.d.ts",
      "import": "./dist/makeStandaloneSessionBackupKey.js",
      "default": "./dist/makeStandaloneSessionBackupKey.js"
    },
    "./bootstrapAggregateSession": {
      "types": "./dist/bootstrapAggregateSession.d.ts",
      "import": "./dist/bootstrapAggregateSession.js",
      "default": "./dist/bootstrapAggregateSession.js"
    },
    "./bootstrapServiceSession": {
      "types": "./dist/bootstrapServiceSession.d.ts",
      "import": "./dist/bootstrapServiceSession.js",
      "default": "./dist/bootstrapServiceSession.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./vite": {
      "types": "./dist/nodeWorkerPlugin.d.ts",
      "import": "./dist/nodeWorkerPlugin.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json && node -e \"const fs=require('node:fs'); const wasm=require.resolve('@livestore/wa-sqlite/dist/wa-sqlite.wasm'); fs.copyFileSync(wasm, 'dist/wa-sqlite.wasm');\" && tsup && node -e \"const fs=require('node:fs');const path=require('node:path');fs.copyFileSync(path.join(path.dirname(require.resolve('wa-sqlite/dist/wa-sqlite-async.mjs')), 'wa-sqlite-async.wasm'),'dist/wa-sqlite-async.wasm');\"",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "oxlint . --format stylish",
    "test:playwright": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@livestore/wa-sqlite": "^1.0.5",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/backup-worker": "workspace:*",
    "@zerospin/core": "workspace:*",
    "@zerospin/devtools": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/schema": "workspace:*",
    "capnweb": "^0.12.0",
    "drizzle-orm": "1.0.0-rc.4",
    "system-worker": "workspace:*",
    "wa-sqlite": "github:rhashimoto/wa-sqlite#07ad48cf2f682d279f9cd69818cc1d39b2ccda86"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "rc",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "effect": "4.0.0-rc.111",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.111"
  },
  "nx": {
    "targets": {
      "test:playwright": {
        "dependsOn": [
          "lib"
        ],
        "cache": false
      }
    }
  }
}
