{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sync-vitest",
  "main": "e2e/worker.ts",
  "compatibility_date": "2025-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "FIXTURE_STATE_REPO", "class_name": "FixtureStateRepo" },
      { "name": "FIXTURE_SYNC_AGENT", "class_name": "FixtureSyncAgent" },
    ],
  },
  "exports": {
    "FixtureStateRepo": { "type": "durable-object", "storage": "sqlite" },
    "FixtureSyncAgent": { "type": "durable-object", "storage": "sqlite" },
  },
}
