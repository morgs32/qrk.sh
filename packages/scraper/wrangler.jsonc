{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scraper",
  "main": "./src/Worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_HOST", "class_name": "BrowserHost" },
      { "name": "LINKTREE_REPO", "class_name": "LinktreeRepo" },
      { "name": "BEACONS_REPO", "class_name": "BeaconsRepo" },
      { "name": "INSTAGRAM_REPO", "class_name": "InstagramRepo" },
      { "name": "GITHUB_REPO", "class_name": "GitHubRepo" },
      { "name": "TIKTOK_REPO", "class_name": "TikTokRepo" },
      { "name": "YOUTUBE_REPO", "class_name": "YouTubeRepo" },
      { "name": "TRUTH_SOCIAL_REPO", "class_name": "TruthSocialRepo" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScraperRepo"] },
    {
      "tag": "v2",
      "new_classes": ["BrowserHost"],
      "new_sqlite_classes": ["LinktreeRepo", "BeaconsRepo", "InstagramRepo", "GitHubRepo", "TikTokRepo", "YouTubeRepo", "TruthSocialRepo"],
      "deleted_classes": ["ScraperRepo"]
    }
  ]
}
