{
  "name": "system-worker",
  "version": "2.0.1",
  "private": false,
  "description": "Zerospin internal APIs (merged library)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/SystemWorker.ts",
      "workerd": "./src/SystemWorker.ts",
      "import": "./src/SystemWorker.ts",
      "default": "./src/SystemWorker.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json --emitDeclarationOnly",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "test": "vitest run --config vitest.node.config.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "test:watch": "vitest --config vitest.node.config.ts",
    "types": "wrangler types -c ./wrangler.jsonc",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "agents": "^0.17.0",
    "cloudflare": "^6.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.17-67b1795",
    "effect": "^3.21.4",
    "es-toolkit": "^1.46.1",
    "partyserver": "^0.5.8",
    "solid-js": "^1.9.12",
    "sql.js": "^1.14.1",
    "tiny-invariant": "^1.3.3",
    "tsafe": "^1.8.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@effect/language-service": "^0.85.1",
    "@effect/opentelemetry": "^0.63.0",
    "@effect/vitest": "^0.29.0",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.12.2",
    "next": "^16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "^6.1.3",
    "system": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "^0.48.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "effect": "^3.17.11",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "solid-js": ">=1.9.7"
  }
}
