{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.node.spec.ts",
    "src/**/*.typecheck.ts",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../core"
    },
    {
      "path": "../error"
    }
  ]
}
