{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "composite": false,
    "incremental": false
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../core"
    },
    {
      "path": "../error"
    }
  ]
}
