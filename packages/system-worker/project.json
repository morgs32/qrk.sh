{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "system-worker",
  "targets": {
    "lib": {
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/core",
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/schema"
          ]
        },
        {
          "target": "config:lib",
          "projects": ["@zerospin/fixtures"]
        }
      ]
    },
    "dev": {
      "continuous": true
    },
    "test:workerd": {
      "executor": "nx:run-script",
      "dependsOn": ["^lib"],
      "options": {
        "script": "test:workerd"
      }
    },
    "static-cutover:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/checkStaticCutover.mjs",
        "cwd": "{projectRoot}"
      }
    }
  }
}
