{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.react.spec.ts",
    "src/**/*.react.spec.tsx",
    "src/tests/**/*.ts",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../core"
    },
    {
      "path": "../error"
    },
    {
      "path": "../live-query"
    },
    {
      "path": "../logger"
    }
  ]
}
