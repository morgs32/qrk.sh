{
  "name": "@zerospin/fragment-ui",
  "version": "0.1.0",
  "private": false,
  "description": "Fragment typography, themes, compositional outlines, and controls",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "src/Combobox.css",
    "src/Dropdown.css",
    "src/assets"
  ],
  "exports": {
    "./FragmentAppearance": {
      "types": "./dist/FragmentAppearance.d.ts",
      "import": "./dist/FragmentAppearance.js",
      "default": "./dist/FragmentAppearance.js"
    },
    "./Outline": {
      "types": "./dist/Outline.d.ts",
      "import": "./dist/Outline.js",
      "default": "./dist/Outline.js"
    },
    "./Combobox": {
      "types": "./dist/Combobox.d.ts",
      "import": "./dist/Combobox.js",
      "default": "./dist/Combobox.js"
    },
    "./Dropdown": {
      "types": "./dist/Dropdown.d.ts",
      "import": "./dist/Dropdown.js",
      "default": "./dist/Dropdown.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run lib",
    "format": "oxfmt tsconfig.json src README.md",
    "format:check": "oxfmt --check tsconfig.json src README.md",
    "lint": "oxlint src --format stylish"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "19.2.7",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  }
}
