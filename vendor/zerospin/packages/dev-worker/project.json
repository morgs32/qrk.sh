{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/dev-worker",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/core",
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/shapes",
            "system-worker"
          ]
        },
        {
          "target": "config:lib",
          "projects": []
        }
      ]
    }
  }
}
