{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/production-worker",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "lib",
          "projects": [
            "@zerospin/core",
            "@zerospin/dev-worker",
            "@zerospin/error",
            "@zerospin/logger",
            "@zerospin/schema",
            "system-worker"
          ]
        },
        {
          "target": "config:lib",
          "projects": ["@zerospin/fixtures"]
        }
      ]
    },
    "test:workerd": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vitest run --config vitest.production.config.ts"],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["lib", "^lib"]
    }
  }
}
