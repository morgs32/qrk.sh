{
  "extends": ["astro/tsconfigs/strict", "../tsconfig.base.json"],
  "compilerOptions": {
    "outDir": "dist",
    "incremental": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": "./src",
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "src/**/*.mdx",
    ".astro/types.d.ts",
    ".astro/content.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.turbo",
    "**/coverage",
    "**/*.tsbuildinfo",
    "**/.pnpm-store",
    ".next"
  ]
}
