{
  "name": "@zerospin/purchase",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "test": "vitest run",
    "bundle:browser": "esbuild src/browserConsumer.typecheck.ts --bundle --platform=browser --format=esm --outfile=dist/browser-proof.js",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/schema": "workspace:*",
    "@zerospin/sdk": "workspace:*",
    "@zerospin/server-only": "workspace:*"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.111",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.5"
  }
}
