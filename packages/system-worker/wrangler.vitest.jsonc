{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "system-worker-test",
  "main": "./src/TestWorker.ts",
  "compatibility_date": "2025-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "OUTBOX_SENDER_FIXTURE", "class_name": "OutboxSenderFixture" },
      {
        "name": "OUTBOX_RECEIVER_FIXTURE",
        "class_name": "OutboxReceiverFixture",
      },
      { "name": "FIXTURE_REPO", "class_name": "FixtureRepo" },
      {
        "name": "FIXED_DO_REPO_FIXTURE",
        "class_name": "FixedDORepoFixture",
      },
      {
        "name": "VERSIONED_DO_REPO_FIXTURE",
        "class_name": "VersionedDORepoFixture",
      },
      { "name": "SYSTEM_REPO", "class_name": "SystemRepo" },
      {
        "name": "VERSIONED_AGGREGATE_REPO",
        "class_name": "VersionedAggregateRepo",
      },
      {
        "name": "VERSIONED_SERVICE_REPO",
        "class_name": "VersionedServiceRepo",
      },
      {
        "name": "AGGREGATE_CHAIN",
        "class_name": "AggregateChain",
      },
      {
        "name": "VERSIONED_AGGREGATE_CHAIN",
        "class_name": "VersionedAggregateChain",
      },
      {
        "name": "VERSIONED_SERVICE_CHAIN",
        "class_name": "VersionedServiceChain",
      },
      {
        "name": "USER_VERSIONED_AGGREGATE_REPO",
        "class_name": "UserVersionedAggregateRepo",
      },
      {
        "name": "USER_VERSIONED_AGGREGATE_CHAIN",
        "class_name": "UserVersionedAggregateChain",
      },
      {
        "name": "SERVICE_ADMITTED_CHAIN",
        "class_name": "ServiceAdmittedChain",
      },
      {
        "name": "FRONTEND_VERSIONED_SERVICE_REPO",
        "class_name": "FrontendVersionedServiceRepo",
      },
      {
        "name": "FRONTEND_SERVICE_CHAIN",
        "class_name": "FrontendServiceChain",
      },
      { "name": "SYSTEM_LOG_REPO", "class_name": "SystemLogRepo" },
      { "name": "SYSTEM_LOG_AGENT", "class_name": "SystemLogAgent" },
    ],
  },
  "exports": {
    "OutboxSenderFixture": { "type": "durable-object", "storage": "sqlite" },
    "OutboxReceiverFixture": { "type": "durable-object", "storage": "sqlite" },
    "FixtureRepo": { "type": "durable-object", "storage": "sqlite" },
    "FixedDORepoFixture": { "type": "durable-object", "storage": "sqlite" },
    "VersionedDORepoFixture": { "type": "durable-object", "storage": "sqlite" },
    "SystemRepo": { "type": "durable-object", "storage": "sqlite" },
    "VersionedAggregateRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "VersionedServiceRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AggregateChain": { "type": "durable-object", "storage": "sqlite" },
    "VersionedAggregateChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "VersionedServiceChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "UserVersionedAggregateRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "UserVersionedAggregateChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ServiceAdmittedChain": { "type": "durable-object", "storage": "sqlite" },
    "FrontendVersionedServiceRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "FrontendServiceChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SystemLogRepo": { "type": "durable-object", "storage": "sqlite" },
    "SystemLogAgent": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": {
    "ZEROSPIN_ENVIRONMENT": "dev",
    "ZEROSPIN_SYSTEM_ID": "sys_local_20260907_fanout",
  },
}
