{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@zerospin/studio",
  "targets": {
    "lib": {
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "outputs": ["{projectRoot}/dist"]
    },
    "storybook": {
      "dependsOn": ["^lib"],
      "continuous": true
    },
    "build-storybook": {
      "dependsOn": ["^lib"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "preview:build": {
      "executor": "nx:run-commands",
      "dependsOn": ["lib"],
      "outputs": ["{projectRoot}/dist/preview"],
      "options": {
        "command": "pnpm exec vite build --outDir dist/preview",
        "cwd": "packages/studio"
      }
    },
    "agent-rpc:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["lib"],
      "options": {
        "command": "node scripts/checkAgentRpc.mjs",
        "cwd": "packages/studio"
      }
    }
  }
}
