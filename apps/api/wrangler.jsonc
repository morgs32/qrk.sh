{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "./Worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "QRKSH",
      "bucket_name": "qrksh",
    },
    {
      "binding": "ASSETS",
      "bucket_name": "assets",
    },
  ],
  "vars": {
    // Local/Miniflare: path is resolved against the Worker origin → GET /assets/*.
    // Production deploy must set the real public R2 host (e.g. https://pub-….r2.dev).
    "R2_PUBLIC_BASE_URL": "/assets",
    "CLERK_AUTHORIZED_PARTY": "http://127.0.0.1:3001",
  },
  "browser": { "binding": "BROWSER", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_HOST", "class_name": "BrowserHost" },
      { "name": "BACKEND_REPO", "class_name": "BackendRepo" },
      { "name": "FIGMA_BACKEND", "class_name": "FigmaBackend" },
      { "name": "GOOGLE_PLACES_BACKEND", "class_name": "GooglePlacesBackend" },
      { "name": "LINK_BACKEND", "class_name": "LinkBackend" },
    ],
  },
  "migrations": [
    {
      // Local bootstrap: BackendRepo replaces GitHubBackend.
      "tag": "v1",
      "new_classes": ["BrowserHost", "StreamlineBackend"],
      "new_sqlite_classes": ["BackendRepo", "FigmaBackend", "GooglePlacesBackend", "LinkBackend"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["StreamlineBackend"],
    },
  ],
}
