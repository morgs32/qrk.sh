{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "system-worker-test",
  "main": "./src/TestWorker.ts",
  "compatibility_date": "2025-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "FIXTURE_REPO", "class_name": "FixtureRepo" },
      {
        "name": "FIXED_DO_REPO_FIXTURE",
        "class_name": "FixedDORepoFixture",
      },
      {
        "name": "E_PLURIBUS_MACHINA_FIXTURE",
        "class_name": "EPluribusMachinaFixture",
      },
      { "name": "SYSTEM_REPO", "class_name": "SystemRepo" },
      {
        "name": "MATERIALIZED_AGGREGATE_REPO",
        "class_name": "MaterializedAggregateRepo",
      },
      {
        "name": "MATERIALIZED_SERVICE_REPO",
        "class_name": "MaterializedServiceRepo",
      },
      {
        "name": "AGGREGATE_COMMAND_CHAIN",
        "class_name": "AggregateCommandChain",
      },
      {
        "name": "AGGREGATE_FRONTEND_PUSHED_COMMAND_CHAIN",
        "class_name": "AggregateFrontendPushedCommandChain",
      },
      {
        "name": "MATERIALIZED_AGGREGATE_FRONTEND_REPO",
        "class_name": "MaterializedAggregateFrontendRepo",
      },
      {
        "name": "AGGREGATE_FRONTEND_FINALIZED_COMMAND_CHAIN",
        "class_name": "AggregateFrontendFinalizedCommandChain",
      },
      {
        "name": "SERVICE_COMMAND_CHAIN",
        "class_name": "ServiceCommandChain",
      },
      {
        "name": "MATERIALIZED_SERVICE_FRONTEND_REPO",
        "class_name": "MaterializedServiceFrontendRepo",
      },
      {
        "name": "SERVICE_FRONTEND_FINALIZED_COMMAND_CHAIN",
        "class_name": "ServiceFrontendFinalizedCommandChain",
      },
      { "name": "SYSTEM_LOG_REPO", "class_name": "SystemLogRepo" },
      { "name": "SYSTEM_LOG_AGENT", "class_name": "SystemLogAgent" },
    ],
  },
  "exports": {
    "FixtureRepo": { "type": "durable-object", "storage": "sqlite" },
    "FixedDORepoFixture": { "type": "durable-object", "storage": "sqlite" },
    "EPluribusMachinaFixture": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SystemRepo": { "type": "durable-object", "storage": "sqlite" },
    "MaterializedAggregateRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "MaterializedServiceRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AggregateCommandChain": { "type": "durable-object", "storage": "sqlite" },
    "AggregateFrontendPushedCommandChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "MaterializedAggregateFrontendRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AggregateFrontendFinalizedCommandChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ServiceCommandChain": { "type": "durable-object", "storage": "sqlite" },
    "MaterializedServiceFrontendRepo": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ServiceFrontendFinalizedCommandChain": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "SystemLogRepo": { "type": "durable-object", "storage": "sqlite" },
    "SystemLogAgent": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": {
    "ZEROSPIN_ENVIRONMENT": "dev",
    "ZEROSPIN_SYSTEM_ID": "sys_local",
  },
}
