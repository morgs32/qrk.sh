{
  "name": "@zerospin/dispatch-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./CloudApiKeyJwtClaimsSchema": {
      "types": "./dist/CloudApiKeyJwtClaimsSchema.d.ts",
      "import": "./dist/CloudApiKeyJwtClaimsSchema.js",
      "default": "./dist/CloudApiKeyJwtClaimsSchema.js"
    },
    "./getSystemWorkerNameFromClaims": {
      "types": "./dist/getSystemWorkerNameFromClaims.d.ts",
      "import": "./dist/getSystemWorkerNameFromClaims.js",
      "default": "./dist/getSystemWorkerNameFromClaims.js"
    },
    "./makeSystemWorkerName": {
      "types": "./dist/makeSystemWorkerName.d.ts",
      "import": "./dist/makeSystemWorkerName.js",
      "default": "./dist/makeSystemWorkerName.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "ts": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "effect": "^3.21.4",
    "system-worker": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.5"
  }
}
