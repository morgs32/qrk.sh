{
  "name": "@zerospin/schema",
  "version": "0.0.0",
  "private": false,
  "description": "Zerospin primitive, table, Effect Schema, and Drizzle mappings",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "prepublishOnly": "pnpm run lib",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/error": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "es-toolkit": "^1.46.1",
    "tsafe": "^1.8.12",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "effect": "rc",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.111"
  }
}
