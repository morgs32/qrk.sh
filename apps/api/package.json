{
  "name": "@qrk.sh/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "wrangler dev --ip 127.0.0.1 --port ${PORT:-8787} --inspector-port 0",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types ./worker-configuration.d.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.5",
    "@qrk.sh/bricks": "workspace:*",
    "@qrk.sh/zerospin": "workspace:*",
    "capnweb": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "wrangler": "4.131.2"
  },
  "portless": {
    "name": "api.qrk",
    "script": "dev:app",
    "appPort": 8787,
    "proxy": true
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^check-imports"
        ]
      }
    }
  }
}
