{
  "name": "@zerospin/live-query",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "types": "./dist/makeLiveQuery.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/core": "workspace:*",
    "drizzle-orm": "1.0.0-beta.17-67b1795",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@types/node": "^25.6.2",
    "effect": "^3.21.4",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
