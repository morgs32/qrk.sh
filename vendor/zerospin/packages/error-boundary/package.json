{
  "name": "@zerospin/error-boundary",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./ZerospinRouteErrorBoundary": {
      "types": "./dist/ZerospinRouteErrorBoundary.d.ts",
      "import": "./dist/ZerospinRouteErrorBoundary.js",
      "default": "./dist/ZerospinRouteErrorBoundary.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json && node -e \"require('node:fs').copyFileSync('src/ZerospinRouteErrorBoundary.css', 'dist/ZerospinRouteErrorBoundary.css')\"",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "prepublishOnly": "pnpm run lib",
    "format": "oxfmt package.json project.json tsconfig.json tsconfig.etc.json vitest.config.ts src",
    "format:check": "oxfmt --check package.json project.json tsconfig.json tsconfig.etc.json vitest.config.ts src",
    "lint": "oxlint . --format stylish",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@zerospin/error": "workspace:*",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.63.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.3.0",
    "rimraf": "^6.1.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=7"
  }
}
