{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "library",
  "main": "./worker/Worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc", "/upload", "/assets/*"],
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "assets",
    },
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "/assets",
  },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_HOST", "class_name": "BrowserHost" },
      { "name": "INSTAGRAM_REPO", "class_name": "InstagramRepo" },
      { "name": "GITHUB_REPO", "class_name": "GitHubRepo" },
      { "name": "FIGMA_REPO", "class_name": "FigmaRepo" },
      { "name": "GOOGLE_PLACES_REPO", "class_name": "GooglePlacesRepo" },
      { "name": "LINK_REPO", "class_name": "LinkRepo" },
      { "name": "TIKTOK_REPO", "class_name": "TikTokRepo" },
      { "name": "STREAMLINE_REPO", "class_name": "StreamlineRepo" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["BrowserHost", "StreamlineRepo"],
      "new_sqlite_classes": [
        "InstagramRepo",
        "GitHubRepo",
        "TikTokRepo",
        "FigmaRepo",
        "GooglePlacesRepo",
        "LinkRepo",
      ],
    },
  ],
}
