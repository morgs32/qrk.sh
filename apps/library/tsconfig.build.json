{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "node", "react/canary"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "app/**",
    ".storybook/**",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "worker/**",
    "vite*.ts",
    "next.config.ts",
    "next-env.d.ts",
    ".next",
    "dist",
    "build",
    "storybook-static",
    "node_modules"
  ]
}
