{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qrk-api",
  "main": "./Worker.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "QRKSH",
      "bucket_name": "qrksh",
    },
  ],
  "vars": {
    // Local/Miniflare: path is resolved against the Worker origin → GET /assets/*.
    // Production deploy must set the real public R2 host (e.g. https://pub-….r2.dev).
    "R2_PUBLIC_BASE_URL": "/assets",
    "CLERK_AUTHORIZED_PARTY": "http://127.0.0.1:3001",
  },
}
