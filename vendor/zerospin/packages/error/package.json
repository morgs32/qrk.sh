{
  "name": "@zerospin/error",
  "version": "2.1.5",
  "private": false,
  "type": "module",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./snapshot-serializers/*.js": {
      "types": "./dist/snapshot-serializers/*.d.ts",
      "import": "./dist/snapshot-serializers/*.js",
      "require": "./dist/snapshot-serializers/*.js",
      "default": "./dist/snapshot-serializers/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "prepublishOnly": "pnpm run lib",
    "lint": "oxlint . --format stylish",
    "knip": "knip"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/node": "^25.6.2",
    "effect": "rc",
    "knip": "^6.12.2",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.111"
  }
}
