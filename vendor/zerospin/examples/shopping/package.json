{
  "name": "shopping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "zerospin:dev": "zerospin dev --port ${ZEROSPIN_PORT:-3005}",
    "deploy:app": "wrangler deploy -c ./dist/wrangler.json",
    "deploy:zerospin": "zerospin deploy --wrangler",
    "types": "wrangler types -c ./wrangler.jsonc",
    "ts": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.etc.json --noEmit",
    "lint": "oxlint . --format stylish",
    "test": "vitest",
    "test:e2e": "playwright test --config system.e2e.playwright.config.ts",
    "test:playwright": "playwright test --config e2e.playwright.config.ts",
    "test:playwright:preview": "playwright test --config e2e.preview.playwright.config.ts",
    "test:playwright:ui": "playwright test --config e2e.playwright.config.ts --ui",
    "test:vitest:browser": "nx run shopping:test:vitest:browser",
    "test:vitest:browser:main": "vitest run --config vitest.playwright.config.ts",
    "test:workerd": "vitest run --config vitest.zerospin.config.ts"
  },
  "dependencies": {
    "@clerk/react-router": "^3.5.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@zerospin/core": "workspace:*",
    "@zerospin/devtools": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/react": "workspace:*",
    "@zerospin/sdk": "workspace:2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "3.21.4",
    "lucide-react": "^1.14.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@clerk/testing": "^1.13.35",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@effect/vitest": "^0.29.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "@zerospin/cli": "workspace:*",
    "@zerospin/dev-worker": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/shared-worker": "workspace:*",
    "capnweb": "^0.7.0",
    "cloudflare": "^6.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.17-67b1795",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "system-worker": "workspace:*",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "1.4.0",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "~4.1.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.118.0"
  }
}
