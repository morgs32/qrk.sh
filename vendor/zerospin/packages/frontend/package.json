{
  "name": "@zerospin/frontend",
  "version": "2.0.1",
  "private": false,
  "description": "Zerospin browser transport programs",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./fetchAggregateFrontendState": {
      "types": "./dist/fetchAggregateFrontendState.d.ts",
      "import": "./dist/fetchAggregateFrontendState.js",
      "default": "./dist/fetchAggregateFrontendState.js"
    },
    "./pushAggregateFrontendCommand": {
      "types": "./dist/pushAggregateFrontendCommand.d.ts",
      "import": "./dist/pushAggregateFrontendCommand.js",
      "default": "./dist/pushAggregateFrontendCommand.js"
    },
    "./createAggregateFrontendWebSocketTicket": {
      "types": "./dist/createAggregateFrontendWebSocketTicket.d.ts",
      "import": "./dist/createAggregateFrontendWebSocketTicket.js",
      "default": "./dist/createAggregateFrontendWebSocketTicket.js"
    },
    "./fetchServiceFrontendState": {
      "types": "./dist/fetchServiceFrontendState.d.ts",
      "import": "./dist/fetchServiceFrontendState.js",
      "default": "./dist/fetchServiceFrontendState.js"
    },
    "./createServiceFrontendWebSocketTicket": {
      "types": "./dist/createServiceFrontendWebSocketTicket.d.ts",
      "import": "./dist/createServiceFrontendWebSocketTicket.js",
      "default": "./dist/createServiceFrontendWebSocketTicket.js"
    },
    "./makeAggregateFrontendBackupKey": {
      "types": "./dist/makeAggregateFrontendBackupKey.d.ts",
      "import": "./dist/makeAggregateFrontendBackupKey.js",
      "default": "./dist/makeAggregateFrontendBackupKey.js"
    },
    "./makeServiceFrontendBackupKey": {
      "types": "./dist/makeServiceFrontendBackupKey.d.ts",
      "import": "./dist/makeServiceFrontendBackupKey.js",
      "default": "./dist/makeServiceFrontendBackupKey.js"
    },
    "./frontendPushRetrySchedule": {
      "types": "./dist/frontendPushRetrySchedule.d.ts",
      "import": "./dist/frontendPushRetrySchedule.js",
      "default": "./dist/frontendPushRetrySchedule.js"
    },
    "./bootstrapAggregateFrontendSession": {
      "types": "./dist/bootstrapAggregateFrontendSession.d.ts",
      "import": "./dist/bootstrapAggregateFrontendSession.js",
      "default": "./dist/bootstrapAggregateFrontendSession.js"
    },
    "./bootstrapServiceFrontendSession": {
      "types": "./dist/bootstrapServiceFrontendSession.d.ts",
      "import": "./dist/bootstrapServiceFrontendSession.js",
      "default": "./dist/bootstrapServiceFrontendSession.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lib": "pnpm run clean && tsc -b tsconfig.json",
    "ts": "tsc -p tsconfig.etc.json --noEmit",
    "watch": "tsc -b tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "oxlint . --format stylish"
  },
  "dependencies": {
    "@zerospin/core": "workspace:*",
    "@zerospin/error": "workspace:*",
    "@zerospin/logger": "workspace:*",
    "@zerospin/opfs-backup-worker": "workspace:*",
    "@zerospin/schema": "workspace:*",
    "capnweb": "^0.12.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "rc",
    "system-worker": "workspace:*"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "rc",
    "@types/node": "^25.6.2",
    "rimraf": "^6.1.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.111"
  }
}
