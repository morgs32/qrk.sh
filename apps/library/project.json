{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@qrk.sh/library",
  "targets": {
    "dev": {
      "continuous": true,
      "dependsOn": ["^lib"]
    },
    "tsc": {
      "dependsOn": ["^lib", "tsc:worker"]
    },
    "build": {
      "dependsOn": ["^lib"]
    },
    "build:app": {
      "dependsOn": ["^lib"]
    },
    "tsc:worker": {
      "dependsOn": ["^lib"]
    },
    "test:workerd": {
      "dependsOn": ["^lib"]
    }
  }
}
