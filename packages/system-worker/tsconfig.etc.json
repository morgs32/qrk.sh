{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": [
      "@cloudflare/vitest-plugin/types",
      "node",
      "vite/client",
      "vitest/globals",
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/workerd-utils/**/*.ts",
    "vitest-env.d.ts",
    "worker-configuration.d.ts",
    "env-types.d.ts",
    "vitest.node.config.ts",
    "vitest.workerd.config.ts",
    "src/fixtures/purchaseAggregate.ts",
    "src/fixtures/purchaseModels.ts",
    "src/fixtures/purchaseFulfillmentClient.ts",
    "src/fixtures/trustedService.ts",
    "src/fixtures/fulfillmentService.ts"
  ],
  "exclude": [],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/error"
    },
    {
      "path": "../config"
    }
  ]
}
