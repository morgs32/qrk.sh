  "dependencies": {
    "@clerk/backend": "^3.8.5",
    "@json-render/core": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "@remix-run/route-pattern": "^0.22.1",
    "@zerospin/core": "32.0.1",
    "@zerospin/error": "32.0.1",
    "@zerospin/logger": "32.0.1",
    "@zerospin/sdk": "32.0.1",
    "@zerospin/shapes": "32.0.1",
    "@zerospin/zod": "32.0.1",
    "capnweb": "^0.12.0",
    "effect": "4.0.2",
    "es-toolkit": "^1.52.0",
    "system-worker": "32.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/node": "^25.5.2",
    "@zerospin/cli": "32.0.1",
    "@zerospin/dev-worker": "32.0.1",
    "cloudflare": "^6.1.0",
