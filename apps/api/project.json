{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@qrk.sh/api",
  "targets": {
    "build": {
      "dependsOn": [
        {
          "projects": ["@qrk.sh/library"],
          "target": "build"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test:workerd": {
      "dependsOn": [
        {
          "projects": ["@qrk.sh/library"],
          "target": "build"
        }
      ]
    },
    "dev": {
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["@qrk.sh/library"],
          "target": "build"
        }
      ]
    },
    "ts": {
      "dependsOn": [
        {
          "projects": ["@qrk.sh/library"],
          "target": "build"
        }
      ]
    }
  }
}
