    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.11",
    "wrangler": "4.131.2"
