  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.typecheck.ts", "vitest.config.ts"],
  "exclude": [],
